{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/ecommerce.db"
  },
  "Store": {
    "Name": "ECommerceStore",
    "CurrencyCode": "USD",
    "ShippingFee": 10.00,
    "LowStockThreshold": 5,
    "CatalogPageSize": 12,
    "AdminPageSize": 20
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "FromAddress": "noreply@localstore.test",
    "FromName": "ECommerceStore"
  },
  "Uploads": {
    "MaximumBytes": 5242880,
    "RelativeRoot": "uploads/products",
    "MaximumWidth": 10000,
    "MaximumHeight": 10000,
    "MaximumPixels": 40000000
  },
  "AI": {
    "Enabled": true,
    "Provider": "Mock"
  },
  "Assistant": {
    "Provider": "Mock",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "",
    "TimeoutSeconds": 30,
    "MaximumToolIterations": 4,
    "MaximumPromptLength": 2000,
    "ProcessingLeaseSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
