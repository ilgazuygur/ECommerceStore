@model ProductListViewModel
@{ ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query.Category) ? "Shop all products" : "Category products"; }

<section class="page-heading"><span class="eyebrow">The complete edit</span><h1>Shop the collection</h1><p>Use the filters to narrow a deliberately concise collection.</p></section>

<div class="catalog-layout">
    <aside class="filter-panel" aria-label="Product filters">
        <form method="get" asp-action="Index">
            <div class="filter-title"><h2>Filters</h2><a asp-action="Index">Clear</a></div>
            <div class="mb-3"><label asp-for="Query.Keyword" class="form-label">Search</label><input asp-for="Query.Keyword" name="Keyword" class="form-control" maxlength="100" placeholder="Product name or description" /></div>
            <div class="mb-3"><label asp-for="Query.Category" class="form-label">Category</label><select asp-for="Query.Category" name="Category" class="form-select"><option value="">All categories</option>@foreach (var category in Model.Categories) { <option value="@category.Slug">@category.Name</option> }</select></div>
            <div class="row g-2 mb-3"><div class="col-6"><label asp-for="Query.MinimumPrice" class="form-label">Min price</label><input asp-for="Query.MinimumPrice" name="MinimumPrice" class="form-control" min="0" step="0.01" /></div><div class="col-6"><label asp-for="Query.MaximumPrice" class="form-label">Max price</label><input asp-for="Query.MaximumPrice" name="MaximumPrice" class="form-control" min="0" step="0.01" /></div></div>
            <div class="form-check form-switch mb-4"><input asp-for="Query.InStockOnly" name="InStockOnly" class="form-check-input" /><label asp-for="Query.InStockOnly" class="form-check-label">In stock only</label></div>
            <input type="hidden" name="Sort" value="@Model.Query.Sort" />
            <button class="btn btn-primary w-100" type="submit">Apply filters</button>
        </form>
    </aside>

    <section class="catalog-results" aria-labelledby="results-heading">
        <div class="results-toolbar"><div><h2 id="results-heading">@Model.TotalCount product@(Model.TotalCount == 1 ? "" : "s")</h2>@if (!string.IsNullOrWhiteSpace(Model.ValidationMessage)) { <p class="text-danger mb-0" role="alert">@Model.ValidationMessage</p> }</div>
            <form method="get" asp-action="Index" class="sort-form">
                <input type="hidden" name="Keyword" value="@Model.Query.Keyword" /><input type="hidden" name="Category" value="@Model.Query.Category" /><input type="hidden" name="MinimumPrice" value="@Model.Query.MinimumPrice" /><input type="hidden" name="MaximumPrice" value="@Model.Query.MaximumPrice" /><input type="hidden" name="InStockOnly" value="@Model.Query.InStockOnly" />
                <label for="sort" class="visually-hidden">Sort products</label><select id="sort" name="Sort" class="form-select" data-autosubmit><option value="Newest" selected="@(Model.Query.Sort == ProductSort.Newest)">Newest</option><option value="PriceLowToHigh" selected="@(Model.Query.Sort == ProductSort.PriceLowToHigh)">Price: low to high</option><option value="PriceHighToLow" selected="@(Model.Query.Sort == ProductSort.PriceHighToLow)">Price: high to low</option><option value="NameAscending" selected="@(Model.Query.Sort == ProductSort.NameAscending)">Name A–Z</option><option value="NameDescending" selected="@(Model.Query.Sort == ProductSort.NameDescending)">Name Z–A</option></select>
                <noscript><button class="button button-secondary button-small" type="submit">Apply</button></noscript>
            </form>
        </div>
        @if (Model.Products.Count == 0) { <partial name="_EmptyState" model='"Try removing a filter or searching for something else."' /> }
        else { <div class="product-grid compact">@foreach (var product in Model.Products) { <partial name="_ProductCard" model="product" /> }</div> }
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-wrap" aria-label="Product pages"><ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-route-Keyword="@Model.Query.Keyword" asp-route-Category="@Model.Query.Category" asp-route-MinimumPrice="@Model.Query.MinimumPrice" asp-route-MaximumPrice="@Model.Query.MaximumPrice" asp-route-InStockOnly="@Model.Query.InStockOnly" asp-route-Sort="@Model.Query.Sort" asp-route-Page="@(Model.Query.Page - 1)">Previous</a></li>
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++) { <li class="page-item @(pageNumber == Model.Query.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-Keyword="@Model.Query.Keyword" asp-route-Category="@Model.Query.Category" asp-route-MinimumPrice="@Model.Query.MinimumPrice" asp-route-MaximumPrice="@Model.Query.MaximumPrice" asp-route-InStockOnly="@Model.Query.InStockOnly" asp-route-Sort="@Model.Query.Sort" asp-route-Page="@pageNumber">@pageNumber</a></li> }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-route-Keyword="@Model.Query.Keyword" asp-route-Category="@Model.Query.Category" asp-route-MinimumPrice="@Model.Query.MinimumPrice" asp-route-MaximumPrice="@Model.Query.MaximumPrice" asp-route-InStockOnly="@Model.Query.InStockOnly" asp-route-Sort="@Model.Query.Sort" asp-route-Page="@(Model.Query.Page + 1)">Next</a></li>
            </ul></nav>
        }
    </section>
</div>
