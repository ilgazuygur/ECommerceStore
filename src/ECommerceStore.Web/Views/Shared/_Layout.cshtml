<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Thoughtfully selected everyday goods from ECommerceStore." />
    <title>@ViewData["Title"] · ECommerceStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg" aria-label="Primary navigation">
            <div class="container py-2">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index" aria-label="ECommerceStore home">
                    <span class="brand-dot"></span>ECommerceStore
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Shop</a></li>
                    </ul>
                    <form class="header-search d-flex my-3 my-lg-0" asp-controller="Catalog" asp-action="Index" method="get" role="search">
                        <label class="visually-hidden" for="headerKeyword">Search products</label>
                        <input id="headerKeyword" class="form-control" name="Keyword" maxlength="100" placeholder="Search the collection" />
                        <button class="btn btn-dark" type="submit">Search</button>
                    </form>
                    <ul class="navbar-nav ms-lg-3 align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" href="/orders">My orders</a></li>
                            <li class="nav-item"><form method="post" asp-area="" asp-controller="Account" asp-action="Logout"><button class="btn nav-link" type="submit">Sign out</button></form></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/account/login">Sign in</a></li>
                            <li class="nav-item"><a class="nav-link" href="/account/register">Register</a></li>
                        }
                        <li class="nav-item"><a class="cart-link" href="/cart">Cart @await Component.InvokeAsync("CartCount")</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
        <div class="container">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="status">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @if (TempData["Warning"] is string warning)
            {
                <div class="alert alert-warning alert-dismissible fade show mt-3" role="status">@warning<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div><div class="brand-mark text-white"><span class="brand-dot"></span>ECommerceStore</div><p>Useful objects, considered details, honest prices.</p></div>
            <div><h2>Explore</h2><a asp-controller="Catalog" asp-action="Index">All products</a><a href="/products?Sort=Newest">Latest arrivals</a></div>
            <div><h2>Support</h2><a href="/Home/Privacy">Privacy</a><span>Development store · USD</span></div>
        </div>
        <div class="container footer-bottom">&copy; 2026 ECommerceStore. Built with ASP.NET Core.</div>
    </footer>
    <section class="assistant-widget" data-assistant-widget data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")" data-login-url="/account/login">
        <button class="assistant-launcher" type="button" data-assistant-open aria-expanded="false" aria-controls="shopping-assistant-panel">
            <span class="assistant-launcher-icon" aria-hidden="true">✦</span>
            <span>Shopping assistant</span>
        </button>
        <div class="assistant-backdrop" data-assistant-close hidden></div>
        <section id="shopping-assistant-panel" class="assistant-panel" role="dialog" aria-modal="true" aria-labelledby="assistant-title" hidden>
            <header class="assistant-header">
                <div>
                    <span class="assistant-kicker">Live catalogue guide</span>
                    <h2 id="assistant-title">Shopping assistant</h2>
                </div>
                <div class="assistant-header-actions">
                    <button class="assistant-icon-button" type="button" data-assistant-new aria-label="Start a new conversation">＋</button>
                    <button class="assistant-icon-button" type="button" data-assistant-close aria-label="Close shopping assistant">×</button>
                </div>
            </header>
            <div class="assistant-shell">
                <aside class="assistant-sidebar" aria-label="Conversations">
                    <div class="assistant-sidebar-title">Conversations</div>
                    <div class="assistant-conversation-list" data-assistant-conversations></div>
                </aside>
                <div class="assistant-chat">
                    <div class="assistant-status" data-assistant-status role="status" aria-live="polite"></div>
                    <div class="assistant-messages" data-assistant-messages aria-live="polite" aria-relevant="additions"></div>
                    <form class="assistant-form" data-assistant-form>
                        @Html.AntiForgeryToken()
                        <label class="visually-hidden" for="assistant-message-input">Message the shopping assistant</label>
                        <textarea id="assistant-message-input" data-assistant-input rows="2" maxlength="2000" placeholder="Ask for products, prices, or in-stock options…"></textarea>
                        <button type="submit" aria-label="Send message">Send</button>
                    </form>
                </div>
            </div>
        </section>
    </section>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/assistant.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
