@model AdminCustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<h1 class="admin-h1">Customers</h1>

<form method="get" class="admin-filter" role="search">
    <input class="form-control" name="Search" value="@Model.Query.Search" placeholder="Name or email" maxlength="256" aria-label="Search customers" />
    <button class="button button-secondary" type="submit">Search</button>
</form>

@if (Model.Customers.Count == 0)
{
    <p class="admin-empty">No customers match your search.</p>
}
else
{
    <div class="table-scroll">
        <table class="data-table">
            <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Orders</th><th scope="col">State</th><th scope="col"></th></tr></thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <th scope="row">@customer.FullName</th>
                        <td>@customer.Email</td>
                        <td>@customer.OrderCount</td>
                        <td><span class="status-pill @(customer.IsEnabled ? "status-paid" : "")">@(customer.IsEnabled ? "Enabled" : "Disabled")</span></td>
                        <td><a class="button button-secondary button-small" asp-action="Details" asp-route-id="@customer.Id">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_AdminPager", (PagedViewModel)Model)
}
