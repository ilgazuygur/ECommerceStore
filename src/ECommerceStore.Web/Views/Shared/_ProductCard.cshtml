@model ProductCardViewModel
<article class="product-card">
    <a class="product-image" href="/products/@Model.Slug" aria-label="View @Model.Name">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" data-fallback="/images/product-placeholder.svg" /> }
        else { <span class="image-placeholder" aria-hidden="true"><span>@Model.Name[..1]</span></span> }
        @if (Model.HasDiscount) { <span class="product-badge">Sale</span> }
        @if (!Model.IsInStock) { <span class="stock-badge">Out of stock</span> }
    </a>
    <div class="product-card-body">
        <a class="category-label" href="/category/@Model.CategorySlug">@Model.CategoryName</a>
        <h3><a href="/products/@Model.Slug">@Model.Name</a></h3>
        <p>@Model.ShortDescription</p>
        <div class="product-price">
            <strong>@Model.EffectivePrice.ToString("C")</strong>
            @if (Model.HasDiscount) { <del>@Model.NormalPrice.ToString("C")</del> }
        </div>
    </div>
</article>
