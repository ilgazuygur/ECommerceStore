@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Admin · ECommerceStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <a class="skip-link" href="#admin-main">Skip to main content</a>
    <header class="admin-topbar">
        <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><span class="brand-dot"></span>Admin</a>
        <div class="admin-topbar-actions">
            <a class="admin-topbar-link" asp-area="" asp-controller="Home" asp-action="Index">View store ↗</a>
            <form method="post" asp-area="" asp-controller="Account" asp-action="Logout"><button class="admin-topbar-link" type="submit">Sign out</button></form>
        </div>
    </header>
    <div class="admin-shell">
        <nav class="admin-nav" aria-label="Admin sections">
            <a class="admin-nav-link @Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="admin-nav-link @Active("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a>
            <a class="admin-nav-link @Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
            <a class="admin-nav-link @Active("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
            <a class="admin-nav-link @Active("Customers")" asp-area="Admin" asp-controller="Customers" asp-action="Index">Customers</a>
        </nav>
        <main id="admin-main" class="admin-main" tabindex="-1">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @if (TempData["Warning"] is string warning)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="status">@warning<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
