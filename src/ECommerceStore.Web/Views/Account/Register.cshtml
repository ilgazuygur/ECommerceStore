@model ECommerceStore.Web.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="account-shell"><div class="account-intro"><span class="eyebrow">Join the store</span><h1>Create your account.</h1><p>Save your cart across sessions, check out, and keep your order history in one place.</p></div><div class="account-panel">
<form asp-action="Register" method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-row"><div><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" /><span asp-validation-for="FirstName"></span></div><div><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" /><span asp-validation-for="LastName"></span></div></div><div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span></div><div><label asp-for="PhoneNumber">Phone number <small>(optional)</small></label><input asp-for="PhoneNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="PhoneNumber"></span></div><div><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span><small>Use at least 8 characters with upper/lowercase, a number, and a symbol.</small></div><div><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="button button-primary button-block" type="submit">Create account</button></form><p>Already registered? <a class="text-link" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
